{
  "name": "CI/CD Failure Auto-Fix",
  "version": "1.0.0",
  "description": "Automatically handles and fixes CI/CD pipeline failures",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "🔴 CI/CD FAILURE - Auto-fix workflow:\n\n1. Get logs: gh run view --log-failed\n2. Identify issue type (build/test/deploy/lint/types)\n3. Fix the issue\n4. Validate: node scripts/validate-for-commit.js\n5. Commit: node scripts/safe-commit-push.js \"fix: [description]\"\n6. Monitor: gh run watch\n\nMax 2 attempts. If still failing, document and ask user."
  }
}
