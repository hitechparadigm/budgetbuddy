#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔒 BudgetBuddy Pre-Commit Security & Quality Checks"
echo "=================================================="
echo ""
echo "⚠️  WARNING: Do NOT use --no-verify flag!"
echo "⚠️  Bypassing these checks violates security policy!"
echo ""

# Track if any check fails
CHECKS_FAILED=0

# 1. Security validation (CRITICAL - MUST PASS)
echo "1️⃣  Running security validation..."
if ! npm run security:pre-commit; then
    echo ""
    echo "❌ SECURITY CHECK FAILED!"
    echo "🚨 CRITICAL: Security vulnerabilities detected"
    echo "🚨 You MUST fix these issues before committing"
    echo ""
    echo "📋 To fix:"
    echo "  1. Run: npm audit fix"
    echo "  2. For breaking changes: npm audit fix --force"
    echo "  3. Review and test changes"
    echo "  4. Commit again (without --no-verify)"
    echo ""
    CHECKS_FAILED=1
fi

# 2. Linting (MUST PASS - no errors allowed)
echo ""
echo "2️⃣  Running ESLint..."
if ! npm run lint:check; then
    echo ""
    echo "❌ LINTING FAILED!"
    echo "🚨 ESLint errors must be fixed before committing"
    echo ""
    echo "📋 To fix:"
    echo "  1. Run: npm run lint (auto-fix)"
    echo "  2. Review changes"
    echo "  3. Commit again"
    echo ""
    CHECKS_FAILED=1
fi

# 3. Type checking (MUST PASS)
echo ""
echo "3️⃣  Running TypeScript type check..."
if ! npm run type-check; then
    echo ""
    echo "❌ TYPE CHECK FAILED!"
    echo "🚨 TypeScript errors must be fixed before committing"
    echo ""
    CHECKS_FAILED=1
fi

# 4. Documentation validation (MANDATORY)
echo ""
echo "4️⃣  Validating documentation updates..."
echo "📚 MANDATORY: All documentation files MUST be updated!"
if ! npm run docs:validate; then
    echo ""
    echo "❌ DOCUMENTATION VALIDATION FAILED!"
    echo "🚨 All mandatory documentation must be updated"
    echo ""
    CHECKS_FAILED=1
fi

# Final verdict
echo ""
echo "=================================================="
if [ $CHECKS_FAILED -eq 1 ]; then
    echo "❌ PRE-COMMIT CHECKS FAILED"
    echo ""
    echo "🚫 COMMIT BLOCKED - Fix the issues above and try again"
    echo ""
    echo "⚠️  DO NOT use 'git commit --no-verify' to bypass these checks!"
    echo "⚠️  Bypassing security checks violates project security policy!"
    echo ""
    exit 1
else
    echo "✅ ALL PRE-COMMIT CHECKS PASSED"
    echo "✅ Commit can proceed safely"
    echo ""
fi
