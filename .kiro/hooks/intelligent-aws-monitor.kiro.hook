{
  "enabled": true,
  "name": "Intelligent AWS Monitor",
  "description": "Proactively monitors for AWS issues and triggers intelligent log analysis only when problems are detected",
  "version": "1",
  "when": {
    "type": "onAgentComplete"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Task completed. Perform intelligent AWS health check:\n\n1. **Quick Health Check**: Check if there are any AWS-related errors or issues in recent work\n2. **Smart Log Analysis**: If issues detected, automatically download and analyze only the problematic AWS service logs\n3. **Selective Download**: Use the enhanced AWS logs script to scan services and download only logs with errors\n4. **Auto-Resolution**: Analyze issues and implement fixes automatically\n5. **Clean Workspace**: Remove log files after analysis\n\nOnly perform log analysis if AWS issues are detected. Otherwise, continue with normal workflow.\n\nFor issues, use: `powershell -ExecutionPolicy Bypass -File scripts/download-aws-logs.ps1`\n\nThis ensures efficient monitoring without unnecessary log downloads."
  },
  "workspaceFolderName": "budgetbuddy",
  "shortName": "intelligent-aws-monitor"
}
