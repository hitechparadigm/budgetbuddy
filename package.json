{
  "name": "budget-buddy",
  "version": "1.0.0",
  "private": true,
  "description": "BudgetBuddy - AI-powered family budgeting application",
  "scripts": {
    "build": "cd infrastructure && npm run build",
    "dev": "cd packages/web-app && npm run dev",
    "dev:web": "cd packages/web-app && npm run dev",
    "lint": "eslint backend/functions/*/index.js --fix",
    "lint:check": "eslint backend/functions/*/index.js",
    "type-check": "cd infrastructure && npm run typecheck",
    "test": "cd backend/functions/transactions && npm install && npm test",
    "test:unit": "cd backend/functions/transactions && npm install && npm test",
    "test:coverage": "cd backend/functions/transactions && npm install && npm test -- --coverage",
    "test:lambda": "cd backend/functions/auth && npm run test && cd ../budget && npm run test && cd ../transactions && npm run test",
    "test:transactions": "node scripts/test-transactions.js",
    "test:journey": "node scripts/test-user-journey.js",
    "create-test-user": "node scripts/create-test-user.js",
    "clean": "echo 'Cleaning build artifacts...'",
    "deploy:dev": "cd infrastructure && npm run deploy:dev",
    "deploy:staging": "cd infrastructure && npm run deploy:staging",
    "deploy:prod": "cd infrastructure && npm run deploy:prod",
    "security:check": "powershell -ExecutionPolicy Bypass -File scripts/security-check-win.ps1",
    "security:check:bash": "bash scripts/security-check.sh",
    "security:pre-commit": "powershell -ExecutionPolicy Bypass -File scripts/security-check-win.ps1 -PreCommit",
    "security:tests": "npx jest tests/security/ --config=tests/security/jest.config.js",
    "docs:validate": "node scripts/validate-documentation.js",
    "docs:validate:strict": "node scripts/validate-documentation.js --strict",
    "docs:update": "node scripts/update-docs-template.js",
    "cleanup:analyze": "node scripts/cleanup-analysis.js",
    "cleanup:execute": "node scripts/cleanup-executor.js",
    "pre-deploy": "npm run security:check && npm run lint:check && npm run test:unit",
    "prepare": "is-ci || husky"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.980.0",
    "@types/jest": "^30.0.0",
    "aws-sdk": "^2.1693.0",
    "eslint": "^9.39.2",
    "fast-check": "^4.5.3",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "jest": "^30.2.0",
    "jest-util": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.0"
  },
  "overrides": {
    "fast-xml-parser": "^5.3.4"
  }
}
