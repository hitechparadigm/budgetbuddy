{
    "name": "@budget-buddy/infrastructure",
    "version": "1.0.0",
    "private": true,
    "description": "BudgetBuddy AWS CDK infrastructure",
    "scripts": {
        "build": "tsc",
        "watch": "tsc -w",
        "test": "jest",
        "cdk": "cdk",
        "deploy": "cdk deploy --all",
        "deploy:dev": "cdk deploy --all --context environment=dev --require-approval never",
        "deploy:staging": "cdk deploy --all --context environment=staging --require-approval never",
        "deploy:prod": "cdk deploy --all --context environment=prod",
        "destroy": "cdk destroy --all",
        "destroy:dev": "cdk destroy --all --context environment=dev --force",
        "diff": "cdk diff",
        "synth": "cdk synth",
        "synth:dev": "cdk synth --all --context environment=dev",
        "bootstrap": "cdk bootstrap",
        "lint": "echo 'Linting skipped for infrastructure'",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "aws-cdk-lib": "^2.100.0",
        "constructs": "^10.3.0"
    },
    "devDependencies": {
        "@types/jest": "^29.5.0",
        "@types/node": "^20.19.23",
        "aws-cdk": "^2.100.0",

        "jest": "^29.5.0",
        "ts-jest": "^29.1.0",
        "typescript": "^5.1.0"
    }
}