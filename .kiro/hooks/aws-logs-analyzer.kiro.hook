{
  "enabled": true,
  "name": "AWS Logs Analyzer",
  "description": "Automatically downloads and analyzes AWS CloudWatch logs when issues are detected, then cleans up",
  "version": "1",
  "when": {
    "type": "onMessage",
    "patterns": ["*AWS*", "*CloudWatch*", "*Lambda*", "*error*", "*failed*", "*timeout*"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "AWS issue detected. Execute automated log analysis workflow:\n\n1. **Download Logs**: Run the AWS logs download script to get recent CloudWatch logs\n2. **Analyze Issues**: Review the downloaded logs for errors, timeouts, and performance issues\n3. **Identify Root Cause**: Determine the specific AWS service and function causing problems\n4. **Implement Fixes**: Apply necessary fixes (code changes, configuration updates, resource adjustments)\n5. **Auto-Cleanup**: Clean up the downloaded log files after analysis\n6. **Verify Resolution**: Test the fixes and ensure AWS services are working properly\n\nUse the PowerShell script: `powershell -ExecutionPolicy Bypass -File scripts/download-aws-logs.ps1`\n\nAfter analysis, automatically clean up with: `Remove-Item -Recurse -Force temp-logs -ErrorAction SilentlyContinue`\n\nWork autonomously to resolve AWS issues without manual intervention."
  },
  "workspaceFolderName": "budgetbuddy",
  "shortName": "aws-logs-analyzer"
}
