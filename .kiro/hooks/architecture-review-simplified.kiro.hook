{
  "enabled": true,
  "name": "Architecture Review (Simplified)",
  "description": "Reviews code changes for architectural best practices without interrupting the continuous workflow",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "infrastructure/lib/*.ts",
      "backend/functions/*/index.js",
      "packages/*/src/**/*.ts",
      "packages/*/src/**/*.tsx"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Perform a quick architectural review of the recent changes. Check for:\n\n1. **Security**: Authentication, authorization, data protection\n2. **AWS Best Practices**: Scalability, cost optimization, serverless patterns\n3. **Code Quality**: SOLID principles, maintainability, performance\n4. **Simplicity**: Avoid over-engineering, keep solutions practical\n\nIf any critical issues are found, fix them immediately. Otherwise, note any minor improvements for future consideration and continue with the current workflow. Do not interrupt the development process unless there are security vulnerabilities or critical architectural flaws."
  },
  "workspaceFolderName": "budgetbuddy",
  "shortName": "architecture-review-simplified"
}
