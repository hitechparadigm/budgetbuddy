#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Run ESLint on Lambda functions to catch syntax errors
echo "📝 Linting Lambda functions..."
npx eslint backend/functions/*/index.js --fix

# Check for common syntax error patterns
echo "🔍 Checking for optional chaining syntax errors..."
if grep -r "? \." backend/functions/*/index.js; then
  echo "❌ Found invalid optional chaining syntax (? .) in Lambda functions!"
  echo "   Please use ?. instead of ? ."
  exit 1
fi

# Run TypeScript compilation check for infrastructure
echo "🏗️  Checking TypeScript compilation..."
cd infrastructure && npm run build && cd ..

# Run basic tests if they exist
if [ -f "package.json" ] && grep -q "\"test\"" package.json; then
  echo "🧪 Running tests..."
  npm test
fi

echo "✅ Pre-commit checks passed!"