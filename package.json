{
    "name": "budget-buddy",
    "version": "1.0.0",
    "private": true,
    "description": "BudgetBuddy - AI-powered family budgeting application",

    "scripts": {
        "build": "cd infrastructure && npm run build",
        "dev": "echo 'Use CDK for local development'",
        "lint": "eslint . --ext .ts,.js --ignore-path .gitignore",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "type-check": "cd infrastructure && npm run typecheck",
        "test": "echo 'Running tests...'",
        "test:unit": "echo 'Running unit tests...'",
        "test:coverage": "echo 'Running coverage tests...'",
        "test:lambda": "cd backend/functions/auth && npm run test && cd ../budget && npm run test && cd ../transactions && npm run test",
        "clean": "echo 'Cleaning build artifacts...'",
        "deploy:dev": "cd infrastructure && npm run deploy:dev",
        "deploy:staging": "cd infrastructure && npm run deploy:staging",
        "deploy:prod": "cd infrastructure && npm run deploy:prod",
        "health-check": "bash scripts/check-deployment.sh"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "eslint": "^8.45.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "jest": "^29.0.0",
        "@types/jest": "^29.0.0",
        "ts-jest": "^29.0.0",
        "prettier": "^3.0.0",
        "typescript": "^5.1.0"
    }
}