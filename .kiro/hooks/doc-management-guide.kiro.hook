{
  "enabled": true,
  "name": "Documentation Management Guide",
  "description": "Monitors when requirements, design, or task documents are created or edited to ensure proper documentation practices - adding to existing documents rather than replacing content, and maintaining separate bug tracking",
  "version": "1",
  "when": {
    "type": "fileCreated",
    "patterns": [
      ".kiro/specs/*/requirements.md",
      ".kiro/specs/*/design.md",
      ".kiro/specs/*/tasks.md"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Spec document created/edited. Ensure:\n1. Adding to existing content (not replacing)\n2. Following spec structure from .kiro/steering/structure.md\n3. Maintaining separation: requirements vs design vs tasks\n\nSee .kiro/SPEC_STRUCTURE_EXPLAINED.md for guidance."
  },
  "workspaceFolderName": "budgetbuddy",
  "shortName": "doc-management-guide"
}
