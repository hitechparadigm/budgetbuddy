#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔒 BudgetBuddy Pre-Commit Hook"
echo "=============================="
echo ""
echo "ℹ️  This hook is a lightweight safety net."
echo "ℹ️  Full validation should be run BEFORE committing."
echo ""

# Check if validation was already run by safe-commit-push.js
# Look for validation marker in recent output or environment
if [ -n "$SKIP_PRECOMMIT_VALIDATION" ]; then
    echo "✅ Validation already completed by safe-commit-push.js"
    echo "✅ Skipping duplicate checks"
    echo ""
    exit 0
fi

# If user is committing directly (not via safe-commit-push.js), run full validation
echo "⚠️  Direct commit detected (not using safe-commit-push.js)"
echo "⚠️  Running full validation as safety check..."
echo ""

# Track if any check fails
CHECKS_FAILED=0

# 1. Security validation (CRITICAL - MUST PASS)
echo "1️⃣  Running security validation..."
if ! npm run security:pre-commit; then
    echo ""
    echo "❌ SECURITY CHECK FAILED!"
    echo "🚨 CRITICAL: Security vulnerabilities detected"
    echo ""
    echo "📋 To fix:"
    echo "  1. Run: npm audit fix"
    echo "  2. Review and test changes"
    echo "  3. Use: node scripts/safe-commit-push.js \"message\""
    echo ""
    CHECKS_FAILED=1
fi

# 2. Linting (MUST PASS - no errors allowed)
echo ""
echo "2️⃣  Running ESLint..."
if ! npm run lint:check; then
    echo ""
    echo "❌ LINTING FAILED!"
    echo ""
    echo "📋 To fix:"
    echo "  1. Run: npm run lint (auto-fix)"
    echo "  2. Use: node scripts/safe-commit-push.js \"message\""
    echo ""
    CHECKS_FAILED=1
fi

# 3. Type checking (MUST PASS)
echo ""
echo "3️⃣  Running TypeScript type check..."
if ! npm run type-check; then
    echo ""
    echo "❌ TYPE CHECK FAILED!"
    echo ""
    CHECKS_FAILED=1
fi

# 4. Documentation validation (MANDATORY)
echo ""
echo "4️⃣  Validating documentation updates..."
if ! npm run docs:validate; then
    echo ""
    echo "❌ DOCUMENTATION VALIDATION FAILED!"
    echo ""
    CHECKS_FAILED=1
fi

# Final verdict
echo ""
echo "=============================="
if [ $CHECKS_FAILED -eq 1 ]; then
    echo "❌ PRE-COMMIT CHECKS FAILED"
    echo ""
    echo "🚫 COMMIT BLOCKED"
    echo ""
    echo "💡 TIP: Use 'node scripts/safe-commit-push.js \"message\"' to validate first"
    echo ""
    echo "⚠️  DO NOT use 'git commit --no-verify' to bypass!"
    echo ""
    exit 1
else
    echo "✅ ALL PRE-COMMIT CHECKS PASSED"
    echo ""
fi

