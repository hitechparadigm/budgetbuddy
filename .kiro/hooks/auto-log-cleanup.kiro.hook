{
  "enabled": true,
  "name": "Auto Log Cleanup",
  "description": "Automatically cleans up AWS logs after analysis is complete to prevent workspace clutter",
  "version": "1",
  "when": {
    "type": "fileCreated",
    "patterns": ["temp-logs/*", "*.log", "*-logs/*"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Log files detected. After analysis complete, cleanup:\npowershell -ExecutionPolicy Bypass -Command \"if (Test-Path 'temp-logs') { Remove-Item -Recurse -Force 'temp-logs' }\""
  },
  "workspaceFolderName": "budgetbuddy",
  "shortName": "auto-log-cleanup"
}
