{
  "name": "budgetbuddy-transactions",
  "version": "1.0.0",
  "description": "BudgetBuddy transaction handler with CRUD operations",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "fast-check": "^3.15.0",
    "jest": "^29.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "*.js",
      "!*.test.js"
    ],
    "moduleNameMapper": {
      "^/opt/nodejs/(.*)$": "<rootDir>/__mocks__/opt/nodejs/$1"
    }
  }
}
