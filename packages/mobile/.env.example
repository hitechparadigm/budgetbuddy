# AWS Configuration for BudgetBuddy Mobile App
# Copy this file to .env and fill in your actual values

# AWS Region where your resources are deployed
EXPO_PUBLIC_AWS_REGION=us-east-1

# AWS Cognito User Pool ID (from your existing backend)
EXPO_PUBLIC_USER_POOL_ID=us-east-1_XXXXXXXXX

# AWS Cognito User Pool Client ID (from your existing backend)
EXPO_PUBLIC_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# AWS Cognito Identity Pool ID (optional, for AWS service access)
EXPO_PUBLIC_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# API Gateway URL (from your existing backend)
EXPO_PUBLIC_API_URL=https://api.budgetbuddy.com

# Features API Gateway URL (Plaid, AI, subscriptions, etc.)
EXPO_PUBLIC_FEATURES_API_URL=https://YOUR_FEATURES_API_ID.execute-api.us-east-1.amazonaws.com/v1

# Development/Testing Configuration
# Set to 'true' for development mode
EXPO_PUBLIC_DEV_MODE=false

# Mock authentication for testing (set to 'true' to bypass AWS Cognito)
EXPO_PUBLIC_MOCK_AUTH=false

# Google OAuth — Client IDs only (public, safe to bundle)
# NEVER add GOOGLE_CLIENT_SECRET with EXPO_PUBLIC_ prefix — use PKCE (no secret needed for mobile)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
