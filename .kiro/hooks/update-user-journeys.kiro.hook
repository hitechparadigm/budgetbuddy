{
  "enabled": true,
  "name": "Update Product Requirements on Feature",
  "description": "Reminds to update docs/product-requirements.md when implementing new features to keep component mapping and gap analysis current",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Before completing this task, check if any new frontend or backend components were created or modified. If so, update docs/product-requirements.md to reflect: 1) Component status changes (❌ → ✅), 2) New components added to the relevant User Journey mapping table, 3) Known Gaps updates (move items from ⚠️ Planned to ✅ Built when done), 4) Implemented Features section updates. This keeps product-requirements.md as the single source of truth for feature implementation status."
  }
}
