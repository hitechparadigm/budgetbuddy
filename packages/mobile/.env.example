# BudgetBuddy mobile app configuration
# Copy this file to .env. Every variable below is read by the app.
# Main API Gateway URL - auth, budget, transactions, accounts, goals, ai
# (the DEV API Gateway; see .kiro/steering/architecture.md)
EXPO_PUBLIC_API_URL=https://q0zoob6728.execute-api.us-east-1.amazonaws.com/v1
# Features API Gateway URL - notifications, tips, learn, debt, comparison,
# export, credit-score, Plaid
EXPO_PUBLIC_FEATURES_API_URL=https://0poeu07vth.execute-api.us-east-1.amazonaws.com/v1
# Extended Features API Gateway URL - insights, receipt, pattern-detection,
# budget-planning, transaction-planning, rules, net-worth
EXPO_PUBLIC_EXTENDED_FEATURES_API_URL=https://hkjzroedjf.execute-api.us-east-1.amazonaws.com/v1
# Budgets API Gateway URL - budget collaboration, members, invitations
EXPO_PUBLIC_BUDGETS_API_URL=https://jcl39tq8x0.execute-api.us-east-1.amazonaws.com/v1
# Google OAuth - Client IDs only (public, safe to bundle)
# NEVER add GOOGLE_CLIENT_SECRET with EXPO_PUBLIC_ prefix - use PKCE (no secret needed for mobile)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
