{
    "name": "budget-buddy",
    "version": "1.0.0",
    "private": true,
    "description": "BudgetBuddy - AI-powered family budgeting application",
    "workspaces": [
        "packages/*",
        "backend",
        "infrastructure"
    ],
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "type-check": "turbo run typecheck",
        "test": "turbo run test",
        "test:unit": "turbo run test:unit",
        "test:coverage": "turbo run test:coverage",
        "test:lambda": "npm run test --prefix backend/functions/auth && npm run test --prefix backend/functions/budget && npm run test --prefix backend/functions/transactions",
        "clean": "turbo run clean",
        "deploy:dev": "cd infrastructure && npm run deploy:dev",
        "deploy:staging": "cd infrastructure && npm run deploy:staging",
        "deploy:prod": "cd infrastructure && npm run deploy:prod",
        "health-check": "bash scripts/check-deployment.sh"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "eslint": "^8.45.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "jest": "^29.0.0",
        "@types/jest": "^29.0.0",
        "ts-jest": "^29.0.0",
        "prettier": "^3.0.0",
        "turbo": "^1.10.0",
        "typescript": "^5.1.0"
    },
    "packageManager": "yarn@3.6.0"
}